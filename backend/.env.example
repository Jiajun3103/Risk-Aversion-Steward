# AI keys (use either ILMU or Z.ai)
ILMU_API_KEY=
ZAI_API_KEY=

# Detection thresholds
LOW_STOCK_DAYS_THRESHOLD=15
SLOW_MOVING_DAILY_SALES_THRESHOLD=1.0
SLOW_MOVING_STOCK_THRESHOLD=40
SLOW_MOVING_DAYS_LEFT_THRESHOLD=45

# SMTP config (optional; when missing, email send falls back safely to "skipped")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Workflow automation
# true: approving an action automatically attempts notification send
# false: keep manual send step (Approve & Send still works)
AUTO_SEND_ON_APPROVAL=false
